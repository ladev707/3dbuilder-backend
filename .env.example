APP_NAME="3D BUILDER"
APP_KEY="SECRET_KEY"
APP_PORT=8080

LOG_LEVEL="DEBUG"

#DATABASE CREDS
DB_HOST=localhost
DB_NAME=local_3dbuilder
DB_USER=postgres
DB_PASSWORD=postgres
DB_URL="postgres://postgres:postgres@localhost:5432/local_3dbuilder?sslmode=disable"

# Use a random value of at least 32 characters outside local development.
AUTH_JWT_SECRET="change-me-to-a-random-secret-at-least-32-characters"
AUTH_JWT_ISSUER="3dbuilder-api"
AUTH_ACCESS_TOKEN_MINUTES=15
AUTH_REFRESH_TOKEN_HOURS=720

# Used only by: go run ./cmd/bootstrap
BOOTSTRAP_GATE=user
BOOTSTRAP_EMAIL="admin@example.com"
BOOTSTRAP_USERNAME=admin
BOOTSTRAP_ROLE=admin
BOOTSTRAP_PASSWORD="replace-with-a-strong-password"

# AUTH
AUTH_JWT_SECRET=SECRET_KEY_32_CHARACTERS_MINIMUM
